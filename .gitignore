.tox/
coverage.xml
*.cover
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# uv (uv.lock is committed: CI installs with `uv sync --frozen`)
.uv/

# Logs
*.log

#config
config/config_azure.yaml
# Folio <= 1.4's single config file: no longer read (1.5 splits it into six files).
config/config.yaml
# Integration-test copy of config/ and scripts/split_config.py's .env lines (secrets)
config/_itest/
.env.split


# File storage (keep directory structure but ignore actual files)
storage/*
!storage/.gitkeep
data/*

# docling
assets/*
# Local test / coverage output (CI produces its own)
reports/

# Eval material stays out of the repo (it may be private); baseline JSON files are committed
evals/rag/documents/*
evals/asr/audio/*
evals/asr/golden_transcripts/*
evals/asr/drafts/*
!evals/**/.gitkeep

# Secrets and per-machine values (DATABASE_URL, model endpoints and keys) — never commit
.env

# Node / frontend build deps
node_modules/

# The generic lib/ rule above must not hide the console source helpers.
!frontend/src/lib/

# Core dumps (a crashed server process leaves a multi-GB core.<pid> here)
core.*
