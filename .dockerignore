# Only what the image needs goes into the build context (see Dockerfile). Never local state or secrets.

# Secrets and local state: uploaded documents, logs, eval reports, model weights
.env
.env.*
!.env.example
assets/
storage/
reports/
logs/
data/
config/_itest/
config/config.yaml
.env.split

# Environments, caches, build output
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
frontend/node_modules/
frontend/dist/

# Repository and editor metadata
.git
.github/
.claude/
.idea/
.vscode/
Dockerfile*
.dockerignore

# Not used at run time (static/console is the committed console build; scripts/rag_eval.py is copied on its own)
tests/
docs/
evals/
frontend/
vendor/
# ...except the metadata uv reads to check the lock (the `local` extra's vendored FireRedASR is never installed)
!vendor/fireredasr_src/pyproject.toml

# config/*.yaml is NOT excluded: the committed files hold no secrets (every secret and per-machine value is a
# ${VAR} reference), and the image starts from them. Supply the real values at runtime through environment
# variables (see .env.example).
