# Tooling and caches
.venv
__pycache__
*.pyc
.git
.gitignore
node_modules
*.egg-info
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov
Dockerfile*
.dockerignore

# Secrets
.env
.env.*

# Local runtime artefacts: uploaded documents, logs, eval reports, local data
# and assets/ (downloaded model weights, local images). None of them belong in
# an image, and they can hold private material; mount model weights at runtime
# or download them in the image build instead.
assets/
storage/
reports/
logs/
data/
config/_itest/
config/config.yaml
.env.split

# config/*.yaml is NOT excluded: the committed files hold no secrets (every secret and
# per-machine value is a ${VAR} reference), and the image starts from them. Supply the
# real values at runtime through environment variables (see .env.example).
