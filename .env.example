# Copy to .env and fill in real values. .env holds every secret and per-machine value;
# config/*.yaml reads them through ${VAR:-default} references and is safe to commit.
# .env overrides any global shell export for this project. An empty value means "not set".

# --- config/database.yaml ---------------------------------------------------------
# PostgreSQL with pgvector. Plain postgresql:// (psycopg2) — no +asyncpg.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/folio
# Only used when DATABASE_URL has no port of its own.
DATABASE_PORT=

# --- config/auth.yaml -------------------------------------------------------------
# MCP Gate base URL (token issuer) and this server's audience (as registered in MCP Gate).
MCP_GATE_URL=http://localhost:4568
FOLIO_AUDIENCE=http://127.0.0.1:5039/mcp
# Where Folio reaches MCP Gate, when not at MCP_GATE_URL (Docker Compose: http://mcp-gate:4568).
# Tokens must still carry iss = MCP_GATE_URL exactly.
MCP_GATE_INTERNAL_URL=
# Revocation feed (docs/auth.md, "Token revocation").
FOLIO_REVOCATION_ENABLED=false
FOLIO_REVOCATION_CLIENT_ID=
FOLIO_REVOCATION_CLIENT_SECRET=

# --- config/models.yaml -----------------------------------------------------------
EMBEDDING_BASE_URL=http://localhost:7075/v1
EMBEDDING_API_KEY=not-needed
LLM_BASE_URL=http://localhost:5052/v1
LLM_API_KEY=not-needed
# Optional contextual-prefix model (uncomment rag.contextual_llm in models.yaml).
CONTEXTUAL_LLM_BASE_URL=
CONTEXTUAL_LLM_API_KEY=
RERANK_BASE_URL=http://localhost:8787
RERANK_API_KEY=not-needed
# Speech-to-text, provider openai-compatible only.
ASR_BASE_URL=
ASR_API_KEY=
# Cloud vision parsing (uncomment rag.parsing in models.yaml).
VISION_BASE_URL=
VISION_API_KEY=
# GPU for docling's local models: cpu / cuda / cuda:N
DOCLING_DEVICE=cuda

# --- config/database.yaml (backups, docs/backup.md) -------------------------------
# true = the server also makes a backup every FOLIO_BACKUP_INTERVAL_HOURS (into database.backup.dir;
# in Docker the folio-backups volume), keeping the newest FOLIO_BACKUP_KEEP.
FOLIO_BACKUP_ENABLED=false
FOLIO_BACKUP_INTERVAL_HOURS=24
FOLIO_BACKUP_KEEP=7

# --- config/retrieval.yaml --------------------------------------------------------
# CKIP Chinese segmenter device: cpu / cuda / cuda:N / auto
CKIP_DEVICE=cpu
# Chinese segmenter for keyword search: ckip | jieba | bigram; unset = the profile's default
# (ckip, or bigram under profile: cloud). The Docker image sets jieba.
# FOLIO_SEGMENTER=

# --- config/system.yaml -----------------------------------------------------------
# Bearer token required by GET /metrics (docs/metrics.md). Empty: only this host may scrape.
METRICS_TOKEN=

# --- optional, read directly by the server ----------------------------------------
# FOLIO_INDEXING_CONCURRENCY=4
# FOLIO_PER_FILE_TIMEOUT_SECONDS=864000
# FOLIO_JOB_TIMEOUT_SECONDS=864000

# --- Docker (docker-compose.yml, the image) ---------------------------------------
# docs/deploy.md. The image's models.yaml (docker/config/models.yaml) is profile: cloud:
# every model is an HTTP endpoint. Inside the container "localhost" is the container
# itself: reach model servers on this machine as host.docker.internal, e.g.
# EMBEDDING_BASE_URL=http://host.docker.internal:8000/v1 (vLLM) or one Forgeyard URL for
# every role. The *_BASE_URL and *_API_KEY variables above apply; these name the models.
# Required by docker-compose.yml (the bundled PostgreSQL):
# POSTGRES_PASSWORD=
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSION=1024           # must match the model; changing it means re-indexing
# EMBEDDING_QUERY_PREFIX=            # e5 models: "query: "
# EMBEDDING_PASSAGE_PREFIX=          # e5 models: "passage: "
# LLM_MODEL=Qwen/Qwen3-4B
# RERANK_ENABLED=true
# RERANK_API=generic                 # generic (/rerank) | score (vLLM /score) | cohere | jina
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct   # PDFs and images are read by this model
# ASR_ENABLED=false                  # true needs ASR_BASE_URL, ASR_MODEL and an image with ffmpeg
# ASR_MODEL=
# The image tag and host ports:
# FOLIO_VERSION=latest               # pin a release of tonyhuang1101/folio, e.g. 1.5.0
# FOLIO_PORT=5039
# The optional MCP Gate in the same stack: also set MCP_GATE_INTERNAL_URL=http://mcp-gate:4568
# COMPOSE_PROFILES=mcp-gate
# MCP_GATE_PORT=4568
# MCP_GATE_ADMIN_EMAIL=              # its owner account; empty = a setup token in its log
# MCP_GATE_ADMIN_PASSWORD=
# Prometheus: /metrics (#11) answers only loopback clients unless METRICS_TOKEN is set; a scrape from the host
# or another container is not loopback, so set it and give Prometheus the same bearer token (docs/deploy.md).
# METRICS_TOKEN=
