# Copy to .env and fill in real values. .env holds every secret and per-machine value;
# config/*.yaml reads them through ${VAR:-default} references and is safe to commit.
# .env overrides any global shell export for this project. An empty value means "not set".

# --- config/database.yaml ---------------------------------------------------------
# PostgreSQL with pgvector. Plain postgresql:// (psycopg2) — no +asyncpg.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/folio
# Only used when DATABASE_URL has no port of its own.
DATABASE_PORT=

# --- config/auth.yaml -------------------------------------------------------------
# MCP Gate base URL (token issuer) and this server's audience (as registered in MCP Gate).
MCP_GATE_URL=http://localhost:4568
FOLIO_AUDIENCE=http://127.0.0.1:5039/mcp
# Revocation feed (docs/auth.md, "Token revocation").
FOLIO_REVOCATION_ENABLED=false
FOLIO_REVOCATION_CLIENT_ID=
FOLIO_REVOCATION_CLIENT_SECRET=

# --- config/models.yaml -----------------------------------------------------------
EMBEDDING_BASE_URL=http://localhost:7075/v1
EMBEDDING_API_KEY=not-needed
LLM_BASE_URL=http://localhost:5052/v1
LLM_API_KEY=not-needed
# Optional contextual-prefix model (uncomment rag.contextual_llm in models.yaml).
CONTEXTUAL_LLM_BASE_URL=
CONTEXTUAL_LLM_API_KEY=
RERANK_BASE_URL=http://localhost:8787
RERANK_API_KEY=not-needed
# Speech-to-text, provider openai-compatible only.
ASR_BASE_URL=
ASR_API_KEY=
# Cloud vision parsing (uncomment rag.parsing in models.yaml).
VISION_BASE_URL=
VISION_API_KEY=
# GPU for docling's local models: cpu / cuda / cuda:N
DOCLING_DEVICE=cuda

# --- config/retrieval.yaml --------------------------------------------------------
# CKIP Chinese segmenter device: cpu / cuda / cuda:N / auto
CKIP_DEVICE=cpu

# --- optional, read directly by the server ----------------------------------------
# FOLIO_INDEXING_CONCURRENCY=4
# FOLIO_PER_FILE_TIMEOUT_SECONDS=864000
# FOLIO_JOB_TIMEOUT_SECONDS=864000
